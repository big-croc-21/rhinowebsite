<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Get Rhino Lab</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    html, body {
      height: 100%;
      font-family: Inter, Arial, sans-serif;
      background: #0d0d0d;
      color: #fff;
    }
    body {
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 24px;
    }
    a { text-decoration: none; color: inherit; }
    .card {
      width: 100%;
      max-width: 380px;
      text-align: center;
    }
    .mark {
      width: 72px;
      height: 72px;
      border-radius: 18px;
      background: #151515;
      border: 1px solid rgba(255,255,255,0.1);
      margin: 0 auto 22px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 800;
      font-size: 0.85rem;
      letter-spacing: 0.04em;
    }
    h1 { font-size: 1.3rem; margin-bottom: 8px; }
    .status { color: #9a9a9a; font-size: 0.92rem; margin-bottom: 26px; min-height: 1.4em; }
    .spinner {
      width: 22px; height: 22px;
      border: 3px solid #2a2a2a;
      border-top-color: #fff;
      border-radius: 50%;
      margin: 0 auto 16px;
      animation: spin 0.8s linear infinite;
    }
    @keyframes spin { to { transform: rotate(360deg); } }
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      width: 100%;
      padding: 15px 20px;
      border-radius: 12px;
      font-weight: 700;
      font-size: 1rem;
      background: #fff;
      color: #111;
      opacity: 0;
      transform: translateY(6px);
      transition: opacity 0.25s ease, transform 0.25s ease;
      pointer-events: none;
    }
    .btn.is-ready { opacity: 1; transform: translateY(0); pointer-events: auto; }
    .apple-icon { width: 19px; height: 19px; flex-shrink: 0; }
    .hint { margin-top: 14px; font-size: 0.8rem; color: #666; }
  </style>
</head>
<body>
  <div class="card">
    <div class="mark">RHINO LAB</div>
    <div class="spinner" id="spinner"></div>
    <h1 id="heading">Get Rhino Lab</h1>
    <p class="status" id="status">Opening the App Store…</p>

    <a class="btn" id="storeBtn" data-store-link href="https://apps.apple.com/us/app/rhino-lab/id6754617994">
      <svg class="apple-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M16.365 1.43c0 1.14-.462 2.16-1.213 2.914-.83.83-2.02 1.42-3.03 1.34-.13-1.1.44-2.24 1.19-2.97.83-.83 2.24-1.44 3.05-1.28zM20.5 17.34c-.5 1.15-.74 1.67-1.39 2.68-.9 1.4-2.17 3.15-3.75 3.16-1.4.02-1.77-.9-3.67-.89-1.9.01-2.31.9-3.71.88-1.58-.02-2.78-1.6-3.68-3-2.52-3.9-2.78-8.48-1.23-10.92 1.1-1.74 2.83-2.76 4.45-2.76 1.65 0 2.69.9 4.06.9 1.32 0 2.13-.9 4.05-.9 1.44 0 2.97.79 4.06 2.15-3.57 1.96-2.99 7.08.81 8.7z"/>
      </svg>
      <span>Download on the App Store</span>
    </a>
    <div class="hint" id="hint" style="display:none;">One tap is required — this preview browser blocks automatic redirects.</div>
  </div>

  <script src="escape.js"></script>
  <script>
    (function () {
      var APP_STORE_URL = "https://apps.apple.com/us/app/rhino-lab/id6754617994";
      var HOMEPAGE_URL = "./rhino-lab-site.html"; // adjust if your homepage lives at a different path

      // ?src= is captured for future use (e.g. once you add a real
      // attribution/MMP link) but has no functional effect today — there is
      // no attribution service wired up, per project setup.
      var params = new URLSearchParams(window.location.search);
      var src = params.get("src");
      if (src) {
        try { console.log("[get] src=" + src); } catch (e) {}
      }

      var spinner = document.getElementById("spinner");
      var status = document.getElementById("status");
      var heading = document.getElementById("heading");
      var btn = document.getElementById("storeBtn");
      var hint = document.getElementById("hint");

      function revealButton(message) {
        spinner.style.display = "none";
        status.textContent = message;
        btn.classList.add("is-ready");
        hint.style.display = "block";
      }

      if (RhinoLabEscape.isInAppBrowser()) {
        // No genuine user gesture exists yet at page load, so any
        // automatic scheme attempt here is very unlikely to succeed (iOS
        // requires a real tap for these to fire) — we don't pretend
        // otherwise. Show a brief "opening" state for continuity, then
        // reveal the real tap-required button. wireStoreLinks() below
        // handles the actual escape attempt + fallback modal once tapped.
        setTimeout(function () {
          revealButton("Tap below to continue");
        }, 900);
      } else if (RhinoLabEscape.isIOS()) {
        // Real Safari/Chrome on iPhone: this just works. Redirect straight
        // through, no button needed.
        status.textContent = "Redirecting to the App Store…";
        window.location.replace(APP_STORE_URL);
      } else {
        // Desktop or any non-iOS context: no Android app to send them to,
        // so send them to the homepage instead of a dead-end store link.
        status.textContent = "Redirecting…";
        window.location.replace(HOMEPAGE_URL + window.location.search);
      }

      RhinoLabEscape.wireStoreLinks("[data-store-link]");
    })();
  </script>
</body>
</html>
